# CodeCraft API Gateway (OpenAI-compatible multi-model access: Claude Opus, Claude 3.5 Sonnet, etc.)
CODECRAFT_API_KEY=
CODECRAFT_MODEL=claude-opus-4.8
CODECRAFT_BASE_URL=https://codecraftapi.com/v1

# Optional AI copy. Choose an available Gemini model in YOUR account.
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional explicit brief assistance; separate from Gemini storyboard copy.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional paid narration. Existing ElevenLabs voice/account choices are respected.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Optional local sound-design bed. SFX fall back to deterministic FFmpeg cues.
# STUDIO_MUSIC_PATH=assets/music/your-licensed-bed.mp3

# Renderer selection. Auto prefers Remotion when its Node/browser runtime is ready.
# It falls back to the Python renderer when Remotion is unavailable.
# STUDIO_RENDERER=auto
# STUDIO_REMOTION_ROOT=remotion-swiggy
# STUDIO_NODE_PATH=/absolute/path/to/node
# REMOTION_BROWSER_EXECUTABLE=/absolute/path/to/chrome-headless-shell
# STUDIO_REMOTION_TIMEOUT=1800
# STUDIO_REMOTION_CONCURRENCY=2
# Linux only when the host does not have Chromium's shared libraries:
# REMOTION_LD_LIBRARY_PATH=/path/to/chromium/libs

# Optional password for the loopback-only studio (username: jarvis).
# Do not expose this local app directly to the internet.
STUDIO_PASSWORD=
