{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ad-engine.local/spec.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["brand", "format", "fps", "durationSec", "bpm", "scenes", "audio"],
  "properties": {
    "brand": {"type": "string", "minLength": 1},
    "format": {"enum": ["9:16", "1:1", "16:9"]},
    "fps": {"enum": [30, 60]},
    "durationSec": {"type": "number", "exclusiveMinimum": 0, "maximum": 120},
    "bpm": {"type": "number", "minimum": 90, "maximum": 140},
    "jobId": {"type": "string"},
    "palette": {
      "type": "object",
      "properties": {
        "background": {"type": "string"},
        "background2": {"type": "string"},
        "surface": {"type": "string"},
        "surfaceText": {"type": "string"},
        "text": {"type": "string"},
        "muted": {"type": "string"},
        "accent": {"type": "string"},
        "accentLight": {"type": "string"},
        "secondary": {"type": "string"},
        "isLightTheme": {"type": "boolean"}
      }
    },
    "mlMatch": {
      "type": "object",
      "properties": {
        "category": {"type": "string"},
        "score": {"type": "number"},
        "template": {"type": "string"},
        "author": {"type": "string"},
        "techTags": {"type": "array", "items": {"type": "string"}},
        "referenceUrl": {"type": "string"},
        "aesthetic": {"type": "object"}
      }
    },
    "scenes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/scene"}},
    "audio": {"$ref": "#/$defs/audio"}
  },
  "$defs": {
    "captionWord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["word", "start", "end"],
      "properties": {"word": {"type": "string"}, "start": {"type": "number", "minimum": 0}, "end": {"type": "number", "exclusiveMinimum": 0}}
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "start", "duration", "layout", "headline", "subline", "visual", "motion", "sfx", "transitionOut"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
        "start": {"type": "number", "minimum": 0},
        "duration": {"type": "number", "exclusiveMinimum": 0, "maximum": 120},
        "layout": {"enum": ["hero-type", "phone", "browser", "photo-overlay", "big-number", "split", "list", "cta"]},
        "headline": {"type": "string", "maxLength": 100},
        "subline": {"type": "string", "maxLength": 180},
        "caption": {"type": "string", "maxLength": 180},
        "captionWords": {"type": "array", "items": {"$ref": "#/$defs/captionWord"}},
        "visual": {"type": "object"},
        "motion": {"type": "object", "additionalProperties": false, "required": ["enter", "idle", "exit"], "properties": {"enter": {"type": "string"}, "idle": {"type": "string"}, "exit": {"type": "string"}, "cursorPath": {"type": "array", "items": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "minItems": 2, "maxItems": 2}}}},
        "vo": {"type": "string"},
        "sfx": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["t", "type"], "properties": {"t": {"type": "number", "minimum": 0}, "type": {"type": "string"}, "gain": {"type": "number", "minimum": 0, "maximum": 1}, "pitchVariation": {"type": "number"}, "duckMusicDb": {"type": "number"}}}},
        "transitionOut": {"type": "string"}
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetsRoot", "voice", "music", "room", "sfxFiles", "duck"],
      "properties": {
        "assetsRoot": {"type": "string", "minLength": 1},
        "voice": {"type": "object", "additionalProperties": false, "required": ["provider", "voiceId", "model", "clips"], "properties": {"provider": {"type": "string"}, "voiceId": {"type": "string"}, "model": {"type": "string"}, "clips": {"type": "object", "additionalProperties": {"type": "string"}}}},
        "music": {"type": "object", "additionalProperties": false, "required": ["file", "mood", "volume"], "properties": {"file": {"type": "string"}, "mood": {"type": "string"}, "volume": {"type": "number", "minimum": 0, "maximum": 1}}},
        "room": {"type": "object", "additionalProperties": false, "required": ["file", "volume"], "properties": {"file": {"type": "string"}, "volume": {"type": "number", "minimum": 0, "maximum": 1}}},
        "sfxFiles": {"type": "object", "additionalProperties": {"type": "string"}},
        "duck": {"type": "number", "minimum": 0, "maximum": 30}
      }
    }
  }
}
