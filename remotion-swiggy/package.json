{
  "name": "brand-agnostic-ad-engine",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "studio": "remotion studio job-entry.tsx",
    "render": "npm run render:raw && npm run master",
    "render:raw": "tsx scripts/render-raw.ts swiggy-001",
    "render:job": "tsx scripts/render-raw.ts",
    "render:project": "tsx scripts/render-project.ts",
    "runtime:check": "node scripts/check-runtime.mjs",
    "master": "tsx scripts/master-render.ts swiggy-001",
    "master:job": "tsx scripts/master-render.ts",
    "stills": "tsx scripts/render-stills.ts swiggy-001",
    "stills:job": "tsx scripts/render-stills.ts",
    "qa": "tsx scripts/qa-report.ts swiggy-001",
    "qa:job": "tsx scripts/qa-report.ts",
    "jobs:generate": "tsx scripts/generate-job-registry.ts",
    "engine:fingerprint": "tsx scripts/engine-fingerprint.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0",
    "knip": "knip",
    "spec-schema": "tsx scripts/validate-spec.ts",
    "brand-leak": "tsx scripts/brand-leak.ts",
    "verify": "npm run jobs:generate && npm run typecheck && npm run lint -- engine jobs job-entry.tsx project-entry.tsx scripts remotion.config.ts && npm run knip && npm run spec-schema && npm run brand-leak",
    "pre-render:raw": "npm run jobs:generate",
    "pre-render:job": "npm run jobs:generate",
    "pre-stills": "npm run jobs:generate",
    "pre-stills:job": "npm run jobs:generate",
    "pre-qa": "npm run jobs:generate",
    "pre-qa:job": "npm run jobs:generate"
  },
  "dependencies": {
    "@remotion/captions": "4.0.533",
    "@remotion/google-fonts": "4.0.533",
    "@remotion/lottie": "4.0.533",
    "@remotion/media": "4.0.533",
    "@remotion/motion-blur": "4.0.533",
    "@remotion/noise": "4.0.533",
    "@remotion/paths": "4.0.533",
    "@remotion/shapes": "4.0.533",
    "@remotion/three": "4.0.533",
    "@remotion/transitions": "4.0.533",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.533"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.533",
    "@remotion/renderer": "4.0.533",
    "@eslint/js": "9.17.0",
    "@remotion/cli": "4.0.533",
    "@remotion/eslint-plugin": "4.0.533",
    "@types/node": "24.0.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "ajv": "8.17.1",
    "eslint": "9.17.0",
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0",
    "knip": "5.46.0",
    "tsx": "4.20.6",
    "typescript": "5.9.2",
    "typescript-eslint": "8.71.1"
  }
}
